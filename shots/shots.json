{
  "app": "/Applications/NetworkMonitor.app",
  "bundle": "com.kevinabouhanna.NetworkMonitor",
  "shots": [
    {
      "name": "settings-general",
      "file": "assets/settings/general.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "general"
      ],
      "window": "General",
      "areas": [
        {
          "match": "data-pane=\"general\"",
          "element": "AXButton:General",
          "h": 48
        },
        {
          "match": "data-pane=\"speed-test\"",
          "element": "AXButton:Speed Test",
          "h": 48
        },
        {
          "match": "data-pane=\"history\"",
          "element": "AXButton:History",
          "h": 48
        },
        {
          "match": "data-pane=\"connections\"",
          "element": "AXButton:Connections",
          "h": 48
        },
        {
          "match": "data-pane=\"shield\"",
          "element": "AXButton:Ads",
          "h": 48
        },
        {
          "match": "data-pane=\"hotspot\"",
          "element": "AXButton:Hotspot",
          "h": 48
        },
        {
          "match": "data-pane=\"about\"",
          "element": "AXButton:About",
          "h": 48
        }
      ],
      "data": [
        {
          "from": "AXStaticText:Counting since",
          "skip": 1
        },
        {
          "from": "AXStaticText:Sampling",
          "skip": 1
        }
      ]
    },
    {
      "name": "settings-speed-test",
      "file": "assets/settings/speed-test.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "speedTest"
      ],
      "window": "Speed Test"
    },
    {
      "name": "settings-history",
      "file": "assets/settings/history.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "history"
      ],
      "window": "History",
      "data": [
        {
          "from": "AXGroup:Usage by hour",
          "until": "AXRadioGroup:List"
        },
        {
          "from": "AXOpaqueProviderGroup"
        }
      ],
      "ignore": [
        "AXStaticText:~on metered connections",
        "AXStaticText:·"
      ]
    },
    {
      "name": "settings-connections",
      "file": "assets/settings/connections.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "connections"
      ],
      "window": "Connections"
    },
    {
      "name": "settings-shield",
      "file": "assets/settings/shield.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "ads"
      ],
      "window": "Ads"
    },
    {
      "name": "settings-hotspot",
      "file": "assets/settings/hotspot.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "hotspot"
      ],
      "window": "Hotspot",
      "areas": [
        {
          "match": "data-row=\"apps\"",
          "element": "AXDisclosureTriangle:Paused on a hotspot",
          "parent": true
        },
        {
          "match": "data-row=\"uncovered\"",
          "element": "AXDisclosureTriangle:Can't be paused",
          "parent": true
        }
      ],
      "data": [
        {
          "from": "AXStaticText:Right now",
          "skip": 1
        }
      ],
      "ignore": [
        "AXStaticText:This connection was already"
      ]
    },
    {
      "name": "settings-hotspot-apps",
      "file": "assets/settings/hotspot-apps.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "hotspot"
      ],
      "window": "Hotspot",
      "click": [
        "AXDisclosureTriangle:Paused on a hotspot"
      ],
      "data": [
        {
          "from": "AXStaticText:Right now",
          "skip": 1
        },
        {
          "from": "AXDisclosureTriangle:Paused on a hotspot",
          "until": "end"
        }
      ],
      "ignore": [
        "AXStaticText:This connection was already"
      ]
    },
    {
      "name": "settings-hotspot-uncovered",
      "file": "assets/settings/hotspot-uncovered.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "hotspot"
      ],
      "window": "Hotspot",
      "click": [
        "AXDisclosureTriangle:Can't be paused"
      ],
      "data": [
        {
          "from": "AXStaticText:Right now",
          "skip": 1
        },
        {
          "from": "AXDisclosureTriangle:Can't be paused",
          "until": "end"
        }
      ],
      "ignore": [
        "AXStaticText:This connection was already"
      ]
    },
    {
      "name": "settings-about",
      "file": "assets/settings/about.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "about"
      ],
      "window": "About",
      "always": true,
      "areas": [
        {
          "match": "class=\"prefs-link\" href=\"#top\"",
          "element": "AXLink:kevinabouhanna",
          "pad": [
            3,
            7
          ]
        },
        {
          "match": "class=\"prefs-link\" href=\"https://github.com/kevinabouhanna/NetworkMonitor/releases/latest\"",
          "element": "AXLink:Release notes",
          "pad": [
            3,
            7
          ]
        },
        {
          "match": "class=\"prefs-link\" href=\"https://github.com/kevinabouhanna/NetworkMonitor\"",
          "element": "AXLink:On GitHub",
          "pad": [
            3,
            7
          ]
        }
      ]
    },
    {
      "name": "connections",
      "file": "assets/connections.png",
      "open": [
        "-open",
        "connections"
      ],
      "window": "Connections",
      "data": [
        {
          "from": "AXUnknown",
          "until": "run"
        },
        {
          "from": "AXOpaqueProviderGroup"
        }
      ]
    },
    {
      "name": "popover",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina"
      ],
      "window": "AXPopover",
      "data": [
        {
          "from": "AXOpaqueProviderGroup"
        }
      ]
    },
    {
      "name": "popover-subprocesses",
      "file": "assets/popover-subprocesses.png",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina"
      ],
      "window": "AXPopover",
      "click": [
        "AXOpaqueProviderGroup>AXButton"
      ],
      "data": [
        {
          "from": "AXOpaqueProviderGroup"
        }
      ]
    },
    {
      "name": "popover-system",
      "file": "assets/popover-system.png",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina"
      ],
      "window": "AXPopover",
      "scroll": "AXScrollArea",
      "data": [
        {
          "from": "AXOpaqueProviderGroup"
        }
      ]
    },
    {
      "name": "speed-test-result",
      "file": "assets/speed-test.png",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina"
      ],
      "window": "AXPopover",
      "click": [
        "AXButton:Speed test"
      ],
      "waitFor": {
        "element": "AXButton:Test Again",
        "seconds": 240
      },
      "when": "popover",
      "skipIf": "AXStaticText:Using hotspot"
    }
  ],
  "assets": [
    {
      "file": "assets/brag.mp4",
      "shows": [
        "popover",
        "popover-subprocesses",
        "connections",
        "settings-shield",
        "speed-test-result",
        "settings-hotspot"
      ]
    },
    {
      "file": "assets/brag-poster.jpg",
      "shows": [
        "popover"
      ]
    },
    {
      "file": "assets/live.mp4",
      "shows": [
        "popover"
      ]
    },
    {
      "file": "assets/live-poster.jpg",
      "shows": [
        "popover"
      ]
    },
    {
      "file": "assets/social-card.png",
      "shows": [
        "popover"
      ]
    },
    {
      "file": "assets/zh-Hans/social-card.png",
      "shows": [
        "popover"
      ]
    },
    {
      "file": "assets/menubar.png",
      "none": "the menu bar readout, which has no accessibility tree to compare: check it by eye when the readout changes"
    },
    {
      "file": "assets/dmg-window.png",
      "none": "the disk image's Finder window, whose background `make dmg-background` draws"
    },
    {
      "file": "assets/icon-256.png",
      "none": "the app icon"
    },
    {
      "file": "assets/apple-touch-icon.png",
      "none": "the app icon"
    },
    {
      "file": "assets/favicon-32.png",
      "none": "the app icon"
    },
    {
      "file": "assets/favicon-64.png",
      "none": "the app icon"
    }
  ],
  "languages": [
    {
      "code": "zh-Hans",
      "page": "zh/index.html",
      "assets": "assets/zh-Hans/",
      "specs": {
        "Can't be paused": "不能暂停",
        "This connection was already": "此连接之前已处于",
        "~on metered connections": "~按流量计费的连接上用了"
      }
    }
  ]
}
