{
  "app": "/Applications/NetworkMonitor.app",
  "bundle": "com.kevinabouhanna.NetworkMonitor",
  "shots": [
    {
      "name": "main-history",
      "file": "assets/main/history.png",
      "open": [
        "-open",
        "history"
      ],
      "window": "Usage History",
      "areas": [
        {
          "match": "data-pane=\"history\"",
          "element": "AXButton:Usage History"
        },
        {
          "match": "data-pane=\"connections\"",
          "element": "AXButton:Connections"
        },
        {
          "match": "data-pane=\"shield\"",
          "element": "AXButton:Ads and Trackers"
        },
        {
          "match": "data-pane=\"network\"",
          "element": "AXButton:Network"
        },
        {
          "match": "data-pane=\"settings\"",
          "element": "AXButton:Settings"
        },
        {
          "match": "data-gear=\"history\"",
          "element": "AXToolbar>AXButton:Settings"
        }
      ],
      "data": [
        {
          "from": "AXGroup:Usage by hour",
          "until": "AXScrollArea"
        },
        {
          "from": "AXOpaqueProviderGroup"
        }
      ]
    },
    {
      "name": "connections",
      "file": "assets/connections.png",
      "open": [
        "-open",
        "connections"
      ],
      "window": "Connections",
      "areas": [
        {
          "match": "data-gear=\"connections\"",
          "element": "AXToolbar>AXButton:Settings"
        }
      ],
      "data": [
        {
          "from": "AXUnknown",
          "until": "run"
        },
        {
          "from": "AXOpaqueProviderGroup"
        }
      ]
    },
    {
      "name": "main-shield",
      "file": "assets/main/shield.png",
      "open": [
        "-open",
        "ads",
        "-tab",
        "overview"
      ],
      "window": "Ads and Trackers",
      "areas": [
        {
          "match": "data-gear=\"shield\"",
          "element": "AXToolbar>AXButton:Settings"
        }
      ],
      "data": [
        {
          "from": "AXStaticText:~blocked",
          "until": "AXMenuButton"
        },
        {
          "from": "AXStaticText:Today",
          "skip": 1
        },
        {
          "from": "AXOpaqueProviderGroup"
        }
      ]
    },
    {
      "name": "main-network",
      "file": "assets/main/network.png",
      "open": [
        "-open",
        "network"
      ],
      "window": "Network",
      "areas": [
        {
          "match": "data-gear=\"network\"",
          "element": "AXToolbar>AXButton:Settings"
        },
        {
          "match": "data-row=\"apps\"",
          "element": "AXDisclosureTriangle:Paused on a hotspot",
          "parent": true
        },
        {
          "match": "data-row=\"uncovered\"",
          "element": "AXDisclosureTriangle:Can't be paused",
          "parent": true
        }
      ],
      "data": [
        {
          "from": "AXStaticText:~ today"
        },
        {
          "from": "AXStaticText:Right now",
          "until": "end",
          "optional": true
        },
        {
          "from": "AXHeading:This network",
          "skip": 2
        },
        {
          "from": "AXStaticText:Any app's updater is stopped",
          "skip": 1,
          "until": "end",
          "optional": true
        }
      ],
      "ignore": [
        "AXStaticText:This connection was already"
      ]
    },
    {
      "name": "main-network-apps",
      "file": "assets/main/network-apps.png",
      "open": [
        "-open",
        "network"
      ],
      "window": "Network",
      "click": [
        "AXDisclosureTriangle:Paused on a hotspot"
      ],
      "data": [
        {
          "from": "AXStaticText:~ today"
        },
        {
          "from": "AXDisclosureTriangle:Paused on a hotspot",
          "until": "end"
        },
        {
          "from": "AXStaticText:Right now",
          "until": "end",
          "optional": true
        },
        {
          "from": "AXHeading:This network",
          "skip": 2
        },
        {
          "from": "AXStaticText:Any app's updater is stopped",
          "skip": 1,
          "until": "end",
          "optional": true
        }
      ],
      "ignore": [
        "AXStaticText:This connection was already"
      ]
    },
    {
      "name": "main-network-uncovered",
      "file": "assets/main/network-uncovered.png",
      "open": [
        "-open",
        "network"
      ],
      "window": "Network",
      "click": [
        "AXDisclosureTriangle:Can't be paused"
      ],
      "data": [
        {
          "from": "AXStaticText:~ today"
        },
        {
          "from": "AXDisclosureTriangle:Can't be paused",
          "until": "end"
        },
        {
          "from": "AXStaticText:Right now",
          "until": "end",
          "optional": true
        },
        {
          "from": "AXHeading:This network",
          "skip": 2
        },
        {
          "from": "AXStaticText:Any app's updater is stopped",
          "skip": 1,
          "until": "end",
          "optional": true
        }
      ],
      "ignore": [
        "AXStaticText:This connection was already"
      ]
    },
    {
      "name": "main-settings",
      "file": "assets/main/settings.png",
      "open": [
        "-open",
        "settings"
      ],
      "window": "Settings",
      "data": [
        {
          "from": "AXStaticText:Counting since",
          "skip": 1
        },
        {
          "from": "AXStaticText:Sampling",
          "skip": 1
        }
      ]
    },
    {
      "name": "settings-history",
      "file": "assets/settings/history.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "history"
      ],
      "window": "Usage History Settings",
      "areas": [
        {
          "match": "class=\"prefs-back\"",
          "element": "AXToolbar>AXButton:Usage History"
        }
      ]
    },
    {
      "name": "settings-connections",
      "file": "assets/settings/connections.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "connections"
      ],
      "window": "Connections Settings"
    },
    {
      "name": "settings-shield",
      "file": "assets/settings/shield.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "ads"
      ],
      "window": "Ads and Trackers Settings",
      "data": [
        {
          "from": "AXStaticText:Built in",
          "until": "end"
        }
      ]
    },
    {
      "name": "settings-network",
      "file": "assets/settings/network.png",
      "open": [
        "-open",
        "settings",
        "-pane",
        "speedTest"
      ],
      "window": "Network Settings"
    },
    {
      "name": "about",
      "file": "assets/about.png",
      "open": [
        "-open",
        "about"
      ],
      "window": "AXWindow",
      "always": true
    },
    {
      "name": "popover",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina",
        "-popoverPeriod",
        "today"
      ],
      "window": "AXPopover",
      "data": [
        {
          "from": "AXOpaqueProviderGroup"
        },
        {
          "from": "AXButton:Network",
          "until": "AXStaticText:Group by",
          "optional": true
        }
      ]
    },
    {
      "name": "popover-subprocesses",
      "file": "assets/popover-subprocesses.png",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina",
        "-popoverPeriod",
        "today"
      ],
      "window": "AXPopover",
      "click": [
        "AXOpaqueProviderGroup>AXButton"
      ],
      "data": [
        {
          "from": "AXOpaqueProviderGroup"
        },
        {
          "from": "AXButton:Network",
          "until": "AXStaticText:Group by",
          "optional": true
        }
      ]
    },
    {
      "name": "popover-system",
      "file": "assets/popover-system.png",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina",
        "-popoverPeriod",
        "today"
      ],
      "window": "AXPopover",
      "scroll": "AXScrollArea",
      "data": [
        {
          "from": "AXOpaqueProviderGroup"
        },
        {
          "from": "AXButton:Network",
          "until": "AXStaticText:Group by",
          "optional": true
        }
      ]
    },
    {
      "name": "speed-test-result",
      "file": "assets/speed-test.png",
      "open": [
        "-open",
        "popover",
        "-popoverScreen",
        "retina",
        "-popoverPeriod",
        "today"
      ],
      "window": "AXPopover",
      "click": [
        "AXButton:Network",
        "AXButton:Test Speed"
      ],
      "waitFor": {
        "element": "AXButton:Test Again",
        "seconds": 240
      },
      "when": "popover",
      "skipIf": "AXButton:~, Hotspot"
    }
  ],
  "assets": [
    {
      "file": "assets/brag.mp4",
      "shows": [
        "popover",
        "popover-subprocesses",
        "connections",
        "main-shield",
        "speed-test-result",
        "main-network"
      ],
      "made": "1.26.7",
