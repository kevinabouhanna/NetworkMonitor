    {
      "file": "assets/favicon-64.png",
      "none": "the app icon"
    }
  ],
  "languages": [
    {
      "code": "zh-Hans",
      "page": "zh/index.html",
      "assets": "assets/zh-Hans/",
      "specs": {
        "Can't be paused": "不能暂停",
        "This connection was already": "此连接之前已处于",
        "~ today": "~ · 今天",
        "~blocked": "~已拦截",
        "~, Hotspot": "~热点",
        "Usage History Settings": "流量历史设置",
        "Connections Settings": "连接设置",
        "Ads and Trackers Settings": "广告与跟踪器设置",
        "Network Settings": "网络设置",
        "Any app's updater is stopped": "使用热点时，任何应用的更新程序都会被停止"
      }
    }
  ]
}
