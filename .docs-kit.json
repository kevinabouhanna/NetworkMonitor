{
  "repo": "kevinabouhanna/NetworkMonitor",
  "name": "NetworkMonitor",
  "docs": "docs",
  "extra_pages": {
    "SECURITY.md": { "copy": "security.md", "slug": "security" }
  },
  "developer_pages": [
    "docs/architecture.md",
    "docs/decisions.md",
    "docs/development.md",
    "docs/roadmap.md"
  ],
  "languages": {
    "zh-Hans": { "name": "简体中文", "site": "zh" }
  },
  "check": {
    "phrase": "No docs needed",
    "needs_docs": [
      { "paths": ["Sources/**/*.swift"], "except": ["Sources/NetworkMonitorTests/**", "Sources/DesignShots/**"], "lines": "\\bL\\(\"" }
    ]
  },
  "site": {
    "url": "https://kevinabouhanna.github.io/NetworkMonitor/",
    "folder": "docs",
    "language": "en",
    "language_name": "English",
    "templates": { "en": "docs/_template.html", "zh-Hans": "zh/docs/_template.html" },
    "strip_lines": ["^English · \\[", "^\\[English\\]\\([^)]*\\) · "]
  },
  "wiki": {
    "names": {
      "SECURITY.md": "Security-Policy",
      "docs/development.md": "Building-Testing-and-Releasing"
    },
    "home": "**Live network speed in your Mac's menu bar, and which apps used your data.**\n\n[Download]({web}/releases/latest/download/NetworkMonitor.dmg) · [Website](https://kevinabouhanna.github.io/NetworkMonitor/) · [Source]({web})\n\n"
  }
}
