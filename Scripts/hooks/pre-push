#!/bin/bash
#
# Runs the suite before anything reaches the remote.
#
# CI runs on every pull request, but it reports after the fact: by then a
# broken commit is already public. This catches it while it is still local and
# fixable with an amend. Nothing is pushed to main directly; see CLAUDE.md.
#
# Installed by `make hooks`, which points core.hooksPath at this directory.
# Bypass for a genuinely urgent push with:  git push --no-verify

set -euo pipefail

# git hands over one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref. A deleted ref has an all-zero local sha and carries no commits, so a push
# of nothing else has nothing to test. No lines at all still runs the suite.
carries_commits=false
deletions=0
while read -r _ local_sha _ _; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    deletions=$((deletions + 1))
  else
    carries_commits=true
  fi
done

if [[ "$carries_commits" == false && "$deletions" -gt 0 ]]; then
  echo "==> pre-push: only deleting, skipping the test suite"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# git runs hooks with GIT_DIR set, and every git the build starts inherits it:
# SwiftPM checking out Sparkle into a fresh worktree's .build then looks for
# Sparkle's commit in this repository, and fails with "unable to read tree"
# (#395).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

echo "==> pre-push: running the test suite"

if ! make test; then
  echo
  echo "✗ Tests failed — push aborted."
  echo "  Fix them, or bypass with: git push --no-verify"
  exit 1
fi

echo "==> pre-push: green, pushing"
