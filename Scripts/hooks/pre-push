#!/bin/bash
#
# Runs the suite before anything reaches the remote.
#
# CI runs on every pull request, but it reports after the fact: by then a
# broken commit is already public. This catches it while it is still local and
# fixable with an amend. Nothing is pushed to main directly; see CLAUDE.md.
#
# Installed by `make hooks`, which points core.hooksPath at this directory.
# Bypass for a genuinely urgent push with:  git push --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> pre-push: running the test suite"

if ! make test; then
  echo
  echo "✗ Tests failed — push aborted."
  echo "  Fix them, or bypass with: git push --no-verify"
  exit 1
fi

echo "==> pre-push: green, pushing"
