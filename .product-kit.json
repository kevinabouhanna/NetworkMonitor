{
  "repo": "kevinabouhanna/NetworkMonitor",
  "name": "NetworkMonitor",
  "docs": "docs",
  "extra_pages": {
    "SECURITY.md": {
      "copy": "security.md",
      "slug": "security"
    }
  },
  "developer_pages": [
    "docs/PLAN.md",
    "docs/architecture.md",
    "docs/decisions.md",
    "docs/development.md",
    "docs/roadmap.md"
  ],
  "plan": {
    "pages": "docs/phases",
    "index": "docs/phases/README.md",
    "project": {
      "owner": "kevinabouhanna",
      "number": 4
    },
    "fields": {
      "order": "Order",
      "horizon": "Horizon",
      "start": "Start date",
      "target": "Target date"
    }
  },
  "languages": {
    "zh-Hans": {
      "name": "简体中文",
      "site": "zh"
    }
  },
  "check": {
    "phrase": "No docs needed",
    "needs_docs": [
      {
        "paths": [
          "Sources/**/*.swift"
        ],
        "except": [
          "Sources/NetworkMonitorTests/**",
          "Sources/DesignShots/**"
        ],
        "lines": "\\bL\\(\""
      }
    ]
  },
  "site": {
    "url": "https://kevinabouhanna.github.io/NetworkMonitor/",
    "folder": "docs",
    "language": "en",
    "language_name": "English",
    "templates": {
      "en": "docs/_template.html",
      "zh-Hans": "zh/docs/_template.html"
    },
    "strip_lines": [
      "^English · \\[",
      "^\\[English\\]\\([^)]*\\) · "
    ]
  },
  "wiki": {
    "names": {
      "SECURITY.md": "Security-Policy",
      "docs/development.md": "Building-Testing-and-Releasing"
    },
    "home": "**Live network speed in your Mac's menu bar, and which apps used your data.**\n\n[Download]({web}/releases/latest/download/NetworkMonitor.dmg) · [Website](https://kevinabouhanna.github.io/NetworkMonitor/) · [Source]({web})\n\n"
  },
  "lang": {
    "source": "en",
    "strings": {
      "format": "strings",
      "path": "Resources/Localization/{code}.lproj/Localizable.strings",
      "keys": {
        "scan": [
          "Sources/NetworkMonitorCore/*.swift",
          "Sources/NetworkMonitor/*.swift"
        ],
        "except": [
          "**/Localization.swift",
          "**/AccessibilityAudit.swift"
        ],
        "call": "L"
      }
    },
    "glossary": "Resources/Localization/{code}.lproj/Glossary.json"
  },
  "shots": {
    "site": "../NetworkMonitor-site",
    "repo_assets": "Resources/README/assets.json",
    "lane": "networkmonitor",
    "launch": {
      "background": [
        "-background",
        "YES"
      ],
      "language": [
        "-language",
        "{code}",
        "-AppleLanguages",
        "({code})"
      ]
    },
    "audit": "Sources/NetworkMonitorCore/AccessibilityAudit.swift",
    "vendor": "Scripts/site-shots.swift",
    "vm": {
      "default": true,
      "image": "networkmonitor",
      "display": "3200x2000",
      "files": [
        "~/Library/Application Support/NetworkMonitor",
        "~/Library/Preferences/com.kevinabouhanna.NetworkMonitor.plist"
      ],
      "prepare": "Scripts/shots-vm-prepare.sh",
      "setup": "Scripts/shots-vm-setup.sh"
    },
    "masks": [
      {
        "pattern": "#\\s?(bytes|[KMGT]?B/s|[KMGT]bps|bps|[KMGT]?B)(?![A-Za-z])",
        "as": "# ‹unit›"
      }
    ],
    "keep_width": [
      "AXMenuBarItem"
    ]
  },
  "upkeep": 606,
  "facts": {
    "version": {
      "from": "tag"
    },
    "size": {
      "from": "command",
      "run": [
        "Scripts/dmg-size.sh"
      ]
    },
    "requires": {
      "en": "macOS 13 or later",
      "zh-Hans": "macOS 13 或更高版本"
    }
  }
}
